@model MeetingReservationSystem.Models.Room
@{
	ViewData["Title"] = "会議室編集";
}

<h2>会議室編集</h2>

<div class="row">
	<div class="col-md-6">
		<form asp-action="Edit" asp-route-id="@Model.RoomId" method="post">
			<input type="hidden" asp-for="RoomId" />
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="form-group mb-3">
				<label asp-for="RoomName" class="form-label"></label>
				<input asp-for="RoomName" class="form-control" />
				<span asp-validation-for="RoomName" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Capacity" class="form-label"></label>
				<input asp-for="Capacity" class="form-control" />
				<span asp-validation-for="Capacity" class="text-danger"></span>
			</div>

			<!-- 表示専用(編集させない項目) -->
			<div class="form-group mb-3">
				<label class="form-label">会議室ID</label>
				<p class="form-control-plaintext">@Model.RoomId</p>
			</div>

			<button type="submit" class="btn btn-primary">更新</button>
			<a asp-action="Index" asp-route-id="@Model.RoomId" class="btn btn-secondary">キャンセル</a>
		</form>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
