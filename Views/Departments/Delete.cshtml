@model MeetingReservationSystem.Models.Department

@{
	ViewData["Title"] = "部署削除";
}

<h2>部署削除</h2>

<div class="row">
	<div class="col-md-6">

		<dl class="row">
			<dt class="col-sm-2">部署ID</dt>
			<dd class="col-sm-10">@Model.DepartmentId</dd>

			<dt class="col-sm-2">部署名</dt>
			<dd class="col-sm-10">@Model.DepartmentName</dd>
		</dl>

		<form asp-action="Delete" asp-route-id="@Model.DepartmentId" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<p>この部署を削除しますか？</p>
			<button type="submit" class="btn btn-sm btn-danger">削除する</button>
			<a asp-action="Index" class="btn btn-sm btn-secondary">キャンセル</a>
		</form>
	</div>
</div>

@section Scripts
{
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}